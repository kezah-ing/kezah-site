---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="section" style="min-height:60vh"><div class="wrap">
    <div class="eyebrow">404</div>
    <h1 class="cs-title" style="font-size:clamp(38px,6vw,76px)">That page has moved or never existed.</h1>
    <p class="lead">Start from the home page, or book a call and tell me what you were looking for.</p>
    <p style="margin-top:28px"><a class="btn btn-primary" href="/">Back to the home page</a></p>
  </div></section>
</Base>
